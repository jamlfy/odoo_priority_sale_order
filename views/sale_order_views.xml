<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_priority" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.priority</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="before">
                <field
                    name="higher_priority"
                    widget="selection_badge"
                    options="{'size': 'sm'}"
                    readonly="higher_disable_priority"
                />
                <field name="higher_disable_priority" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_inherit_higher_priority" model="ir.ui.view">
        <field name="name">sale.order.list.inherit.higher.priority</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name'] | //tree/field[@name='name']" position="after">
                <field name="higher_priority" widget="selection_badge" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="sale_quotation_tree_inherit_higher_priority" model="ir.ui.view">
        <field name="name">sale.quotation.list.inherit.higher.priority</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name'] | //tree/field[@name='name']" position="after">
                <field name="higher_priority" widget="selection_badge" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
